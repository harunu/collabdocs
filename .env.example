# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Frontend (Vite build-time) ────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Leave empty locally — Vite dev-server proxy handles /api and /ws automatically.
# In production set these to your Railway backend URLs:
#   VITE_API_URL=https://collabdocs-backend.up.railway.app
#   VITE_WS_URL=wss://collabdocs-backend.up.railway.app/ws
VITE_API_URL=
VITE_WS_URL=

# ── E2E test users (never use real accounts here) ─────────────────────────────
E2E_TEST_EMAIL=e2e-test@collabdocs.test
E2E_TEST_PASSWORD=TestPassword123!
E2E_TEST_EMAIL_2=e2e-test2@collabdocs.test
E2E_TEST_PASSWORD_2=TestPassword123!
